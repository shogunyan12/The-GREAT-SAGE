# Byte-compiled Python
__pycache__/
*.pyc
*.pyo

# Virtual environments
venv/
.venv/
env/
ENV/

# Secrets / local environment overrides
.env
*.env.local

# Voice samples, split by what they are FOR.
#
# candidates/ IS shipped: those are the voices Great Sage actually speaks
# with, and the settings panel picks between them. Without them a fresh
# clone has no reference audio and no voice at all, which is most of the
# point of the project.
#
# my_voice*.* is NOT: raw personal recordings of whoever set this up,
# kept local.
voice_samples/*
!voice_samples/.gitkeep
!voice_samples/candidates/
!voice_samples/candidates/**

# Model weights / checkpoints, in case any ever end up in-repo instead of
# in the global TTS/torch cache.
*.pt
*.pth
*.onnx
*.safetensors
*.ckpt

# OS cruft
Thumbs.db
.DS_Store

# HUD app runtime log (run_hud.py)
great_sage_hud.log

# Long-term memory file - personal facts about whoever is running this,
# not something to track in version control.
memory.txt
.jbb_cache/
build/
dist/
# Split archives for a GitHub release - gigabytes of build output,
# rebuilt by package_release.py whenever they are needed.
release/
*.spec.bak

# Python 3.11 venv holding PySide6 6.4.3 for the transparent overlay.
# Recreate with:  py -3.11 -m venv .overlay-venv
#                 .overlay-venv\Scripts\pip install PySide6==6.4.3
.overlay-venv/

# Runtime state, per-machine.
great_sage.log
great_sage_hud.log

# Abandoned venv from the packaging investigation. The overlay builds from
# .overlay-venv; this one only ever held pip.
.build311/

# Per-machine runtime state, not source (spec S0: keep user data separate).
#
# Anchored with a leading slash - these are the RUNTIME files at the repo
# root. Without it the pattern matches at any depth and also swallowed
# defaults/hud_settings.json, which is the opposite: the tuned settings a
# fresh install starts from, and the whole reason a download looks like
# the thing that was built.
/hud_settings.json
/voice_line_prefs.json
/chats.json
/chats.json.bak

# API keys - never commit these.
ai_settings.json

# Scheduled reminders and folder watches - personal.
tasks.json
/_preview_raphael.html
/.claude/launch.json
/hud_settings.json.bak
